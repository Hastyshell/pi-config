{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "extensions/**/*.ts"
  ],
  "exclude": [
    "extensions/files-widget/**/*.ts",
    "extensions/pi-web-access/**/*.ts"
  ]
}
